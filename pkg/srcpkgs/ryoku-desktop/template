# ============================================================================
# Template file for 'ryoku-desktop' — port de Void (Hyprland + runit)
# ----------------------------------------------------------------------------
# Paquete NATIVO del port: todo el payload de Ryoku vive bajo xbps, de modo
# que `xbps-install -yR <repo local> ryoku-desktop` lo instala/actualiza y
# `xbps-remove ryoku-desktop` lo desinstala limpio (nada suelto en
# /usr/local/bin ni en /usr/lib/qt6/qml sin rastrear).
#
# CÓMO SE CONSTRUYE (flujo de ryoku-void-install.sh):
#   1. El instalador compila los binarios Go/CMake, el plugin QML, los módulos
#      QML, los scripts y la config base, y los deja en FHS dentro de
#      srcpkgs/ryoku-desktop/files/payload/  (usr/bin, usr/lib, usr/share...).
#   2. `./xbps-src pkg ryoku-desktop` empaqueta ese payload tal cual
#      (do_build es un no-op deliberado: no se compila nada dentro de xbps-src,
#      la compilación es anterior y auditada por el instalador).
#   3. xbps-rindex -a + xbps-install -yR desde hostdir/binpkgs.
#
# El version se inyecta con `sed` desde el instalador (git describe del
# monorepo); el valor por defecto sirve para probar la plantilla a mano.
# ============================================================================
pkgname=ryoku-desktop
version=0.0.0
revision=1
archs="x86_64"
short_desc="Ryoku desktop payload for Void (Hyprland, Quickshell, runit)"
maintainer="Ryoku Void Port <ryoku-void-port@local>"
license="GPL-3.0-or-later, AGPL-3.0-or-later, MIT"
homepage="https://github.com/RepX1233/ryoku-void-port"

# --- cierre de runtime -------------------------------------------------------
# Compositor (stack completo), sesión (runit/turnstile/elogind), toolkits,
# herramientas que la shell llama por nombre y tipografías de la UI.
depends="
