# --- política del port -------------------------------------------------------
# /etc/ryoku-release y /etc/ryoku/boot-guard.conf los escribe el instalador
# (canal/commit/usuario locales), no este paquete: así un rebuild manual del
# paquete no pisa la configuración de arranque de esta máquina.

do_build() {
	# Payload precompilado por ryoku-void-install.sh en $FILESDIR/payload.
	:
}

do_install() {
	local payload="$FILESDIR/payload"
	if [ ! -d "$payload" ]; then
		printf 'ryoku-desktop: falta %s\n' "$payload" >&2
		printf 'lo genera ryoku-void-install.sh antes de ./xbps-src pkg ryoku-desktop\n' >&2
		return 1
	fi
	# El payload ya está en layout FHS (usr/bin, usr/lib, usr/share, ...).
	cp -a "$payload/." "$DESTDIR/"
	# Higiene: nada de artefactos de build dentro del paquete.
	rm -f "$DESTDIR"/usr/lib/qt6/qml/Ryoku/*/install.sh \
	      "$DESTDIR"/usr/lib/qt6/qml/Ryoku/*/*.pyc 2>/dev/null || true
	rm -rf "$DESTDIR"/usr/lib/qt6/qml/Ryoku/*/__pycache__ 2>/dev/null || true
	chmod -R u=rwX,go=rX "$DESTDIR/usr" "$DESTDIR/etc" 2>/dev/null || true
	# Los binarios y los run de servicios deben ser ejecutables.
	find "$DESTDIR/usr/bin" "$DESTDIR/usr/lib/ryoku" -type f -exec chmod 755 {} + 2>/dev/null || true
}
