 hypridle
 hyprlock
 hyprsunset
 hyprpicker
 hyprpolkitagent
 xdg-desktop-portal-hyprland
 xdg-desktop-portal-gtk
 xdg-utils
 xdg-user-dirs
 qt6-base
 qt6-declarative
 qt6-multimedia
 qt6-svg
 qt6-wayland
 pipewire
 wireplumber
 pulseaudio-utils
 rtkit
 dbus
 elogind
 turnstile
 polkit
 NetworkManager
 gnome-keyring
 matugen
 grim
 slurp
 wl-clipboard
 wl-clip-persist
 cliphist
 playerctl
 wf-recorder
