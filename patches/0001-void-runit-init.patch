 func InstalledVersion() string {
diff --git a/ryoku/shell/ipc/session.go b/ryoku/shell/ipc/session.go
--- a/ryoku/shell/ipc/session.go	2026-11-17 22:07:58.284354897 -0600
+++ b/ryoku/shell/ipc/session.go	2026-11-17 22:09:52.286044800 -0600
@@ -4,6 +4,7 @@
 	"encoding/json"
 	"fmt"
 	"log"
+	"os/exec"
 
 	"github.com/godbus/dbus/v5"
 
@@ -65,7 +66,37 @@
 	}
 	go func() {
 		if err := login1PowerCall(method); err != nil {
-			log.Printf("ryoku-shell: session %s: %v", action, err)
+			log.Printf("ryoku-shell: session %s (login1): %v", action, err)
+			// Void sin elogind (sólo seatd + runit): no hay login1 en el bus y
+			// no existe systemctl. Se cae a loginctl y, en último extremo, a los
+			// binarios directos del sistema.
+			runSessionPowerFallback(action)
 		}
 	}()
 }
+
+// runSessionPowerFallback maps the dialog verbs onto loginctl verbs and onto
+// the direct binaries, trying them in that order.
+func runSessionPowerFallback(action string) {
+	var loginctlVerb, direct string
+	switch action {
+	case "reboot":
+		loginctlVerb, direct = "reboot", "reboot"
+	case "shutdown":
+		loginctlVerb, direct = "poweroff", "poweroff"
+	default:
+		log.Printf("ryoku-shell: session %s: sin fallback de energía", action)
+		return
+	}
+	if _, err := exec.LookPath("loginctl"); err == nil {
+		if err := exec.Command("loginctl", loginctlVerb).Run(); err == nil {
+			return
+		}
+	}
+	if _, err := exec.LookPath(direct); err == nil {
+		if err := exec.Command(direct).Run(); err == nil {
+			return
+		}
+	}
+	log.Printf("ryoku-shell: session %s: sin login1, ni loginctl, ni %s", action, direct)
+}
