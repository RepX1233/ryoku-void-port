#!/bin/sh
# ============================================================================
# [LEGADO/MIGRADO] ryoku-shell — stub del antiguo watchdog de sistema
# ----------------------------------------------------------------------------
# Este servicio ya NO supervisa la shell. El port viejo era un servicio de
# SISTEMA que corría como root y raspaba /proc/$PID/environ cada 5s con el
# usuario y el UID hardcodeados (subaru / 1000) — eliminate en la Paso 2B.
#
# Ahora los daemon los posee runit como SERVICIOS DE USUARIO a través de
# turnstile:
#   * definiciones:   /usr/lib/ryoku/runit/user/{ryoku-shell,ryogami}
#                     (provisionadas en ~/.config/service por ryoku-sv-provision)
#   * entorno:        publicado por bin/ryoku-session-init en exec-once
#                     ($XDG_RUNTIME_DIR/ryoku-env, consumido con chpst -e)
#   * control:        SVDIR=$XDG_RUNTIME_DIR/service sv {up,down,restart} ...
#
# Este stub sólo deja constancia y se aparca para que runsv no lo relance.
# Si tienes /etc/sv/ryoku-shell enlazado de una instalación anterior:
#   sudo rm /etc/sv/ryoku-shell /var/service/ryoku-shell
# ============================================================================
exec 2>&1

echo "ryoku-shell (sistema): servicio migrado a turnstile (~/.config/service/ryoku-shell)."
echo "  Retira el symlink: sudo rm -f /etc/sv/ryoku-shell /var/service/ryoku-shell"

# El dueño del ciclo ahora es runit de usuario: aparcar este oneshot.
exec sv down .
